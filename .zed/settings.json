
{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "cargo": {
          "buildScripts": { "enable": true },
          "loadOutDirsFromCheck": true
        },
        "procMacro": {
          "enable": true,
          "attributes": { "enable": true }
        }
      }
    }
  }
}
